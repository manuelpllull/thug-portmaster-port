         if(glstate->gleshard->program != glstate->fpe->prog)
@@ -2207,3 +2230,82 @@ int builtin_CheckVertexAttrib(program_t *glprogram, char* name, GLint id) {
     }
     return 0;
 }
+
+// ---------------------------------------------------------------------------
+// THUG R36S: helpers for the port's direct GLES path (world batches drawn with
+// real GLES calls, see Code/Gfx/Vita/p_shader_decor.cpp). The port draws
+// inside its own real VAOs and sampler objects, then calls
+// gl4es_thug_restore() so the real state matches what gl4es believes again.
+// ---------------------------------------------------------------------------
+#include "texture.h"
+#include "buffers.h"
+#include "shader.h"
+
+void* gl4es_thug_real_proc(const char *name) {
+    return proc_address(NULL, name);
+}
+
+// Real texture name and the filters gl4es applied to it. 0 when the texture
+// is not a plain, uploaded GL_TEXTURE_2D (then the port keeps the gl4es path).
+int gl4es_thug_tex(GLuint name, GLuint *real, GLenum *minf, GLenum *magf) {
+    gltexture_t *t = gl4es_getTexture(GL_TEXTURE_2D, name);
+    if(!t || !t->valid || !t->glname || t->adjust || t->streamed)
+        return 0;
+    *real = t->glname;
+    *minf = t->actual.min_filter ? t->actual.min_filter : t->sampler.min_filter;
+    *magf = t->actual.mag_filter ? t->actual.mag_filter : t->sampler.mag_filter;
+    return 1;
+}
+
+GLuint gl4es_thug_buf(GLuint name) {
+    glbuffer_t *b = getbuffer_id(name);
+    return b ? b->real_buffer : 0;
+}
+
+// GLSL ES source gl4es compiled for this shader (its converted text).
+const char* gl4es_thug_shader_es(GLuint shader) {
+    khash_t(shaderlist) *shaders = glstate->glsl->shaders;
+    khint_t k = kh_get(shaderlist, shaders, shader);
+    if(k == kh_end(shaders))
+        return NULL;
+    shader_t *s = kh_value(shaders, k);
+    return s->converted ? s->converted : NULL;
+}
+
+// Put back the real program, active unit, 2D texture of units [0, units) and
+// GL_ARRAY_BUFFER binding that gl4es has cached.
+void gl4es_thug_restore(int units) {
+    LOAD_GLES(glBindTexture);
+    LOAD_GLES(glActiveTexture);
+    LOAD_GLES(glBindBuffer);
+    LOAD_GLES2(glUseProgram);
+    for(int i=0; i<units && i<hardext.maxtex; ++i) {
+        gles_glActiveTexture(GL_TEXTURE0+i);
+        gles_glBindTexture(GL_TEXTURE_2D, glstate->actual_tex2d[i]);
+    }
+    gles_glActiveTexture(GL_TEXTURE0+glstate->gleshard->active);
+    gles_glUseProgram(glstate->gleshard->program);
+    gles_glBindBuffer(GL_ARRAY_BUFFER, glstate->bind_buffer.array);
+}
+
+// THUG R36S presenter thread: the render context has no window surface. Every
+// bind of "framebuffer 0" by gl4es goes to this off-screen buffer instead
+// (gl4es already redirects 0 to mainfbo_fbo); the port switches it each frame.
+void gl4es_thug_set_mainfbo(GLuint fbo, GLuint tex, int w, int h) {
+    LOAD_GLES2_OR_OES(glBindFramebuffer);
+    glstate->fbo.mainfbo_fbo = fbo;
+    glstate->fbo.mainfbo_tex = tex;
+    glstate->fbo.mainfbo_width = w;
+    glstate->fbo.mainfbo_height = h;
+    if (glstate->fbo.current_fb->id == 0)
+        gles_glBindFramebuffer(GL_FRAMEBUFFER, fbo);
+}
+
+// THUG R36S: the port quits with exit() and never calls close_gl4es(), so the
+// PrecompiledShaderArchive (fixed-pipeline programs, saved as binaries) was
+// never written and every launch recompiled them at first use. Called from an
+// atexit handler: only serialises binaries gl4es already holds in memory.
+void fpe_writePSA();
+void gl4es_thug_save_psa(void) {
+    fpe_writePSA();
+}
